# Server-only secrets. Copy to .env; never prefix secrets with VITE_.
PORT=4000
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
DATABASE_PATH=./data/demo.sqlite
UPLOAD_DIR=./data/uploads
TRUST_PROXY=0
SESSION_DAYS=7
# demo is a local simulation; swifta makes real API calls; disabled uses pay-after-service.
PAYMENT_ADAPTER=demo
SWIFTA_BASE_URL=https://app.swifta.co.ke
SWIFTA_API_STYLE=v1
SWIFTA_PUSH_PATH=/v1/stk/push
# Confirm the status endpoint for your v1 app. Public documentation uses /poll/{id}.
SWIFTA_POLL_PATH=/poll/{id}
SWIFTA_API_KEY=
SWIFTA_APP_ID=
SWIFTA_WEBHOOK_SECRET=
# Configure this URL in the Swifta dashboard once the app has a public HTTPS domain.
SWIFTA_WEBHOOK_URL=https://YOUR_DOMAIN/api/swifta/webhook
# Existing test callbacks supplied by owner (reference only; no automatic forwarding).
SWIFTA_EXISTING_CALLBACK_URL=https://parseify.online/api/swifta/callback
SWIFTA_EXISTING_WEBHOOK_URL=https://parseify.online/api/swifta/webhook
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
BACKUP_DIR=./data/backups
